# ─────────────────────────────────────────────
# PulseNet — Environment Variables Template
# Copy to .env and fill values. Never commit .env.
# ─────────────────────────────────────────────

# ── App ───────────────────────────────────────
ENV=development

# ── AWS RDS (PostgreSQL) ──────────────────────
# Get the RDS endpoint from your AWS console:
DATABASE_URL=postgresql+asyncpg://pulsenet_user:your_password@your-rds-endpoint.rds.amazonaws.com:5432/pulsenet

# ── Backend ───────────────────────────────────
SECRET_KEY=change_me_to_a_long_random_string
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Frontend (Vite env vars must start with VITE_) ──
VITE_API_URL=http://localhost:8000

# ── AWS Credentials (for SDK calls from backend) ─
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── AWS SageMaker (ML ranking model) ─────────
SAGEMAKER_ENDPOINT_NAME=pulsenet-xgboost-endpoint

# ── AWS Bedrock (Conversational AI) ──────────
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# ── AWS Cognito (Auth) ────────────────────────
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=us-east-1

# ── AWS SNS/SES (Notifications) ──────────────
SNS_TOPIC_ARN=
SES_SENDER_EMAIL=noreply@pulsenet.ai
