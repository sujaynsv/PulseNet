# PulseNet — Environment Variables
# Copy this file to `.env` and fill in the values below.

ENV=development

# ------------------------------------------------------------------------------
# 1. API Configuration
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000

# Set DEMO_MODE to true to bypass AWS Cognito and use local demo login
# Demo accounts: admin@demo.com, donor@demo.com, patient@demo.com
DEMO_MODE=true

# Random string used to sign JWTs in DEMO_MODE
# Generate one via `openssl rand -hex 32`
SECRET_KEY=change-me-in-production

# ------------------------------------------------------------------------------
# 2. Database (AWS RDS PostgreSQL)
# ------------------------------------------------------------------------------
# To create RDS instance, run:
# aws rds create-db-instance --db-instance-identifier pulsenet-db --db-instance-class db.t3.micro --engine postgres --master-username pulsenet_user --master-user-password YOUR_PASS --allocated-storage 20 --publicly-accessible --region us-east-1
DATABASE_URL=postgresql+asyncpg://pulsenet_user:YOUR_PASS@YOUR-RDS.rds.amazonaws.com:5432/pulsenet

# ------------------------------------------------------------------------------
# 3. AWS Credentials
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------------------
# 4. AWS Cognito (Auth)
# ------------------------------------------------------------------------------
# 1. Create User Pool with 3 Groups (Admin, Donor, Patient)
# 2. Create App Client (enable ALLOW_USER_PASSWORD_AUTH)
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_XXXXXXX
COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXX
COGNITO_CLIENT_SECRET=  # Leave blank if app client has no secret

# ------------------------------------------------------------------------------
# 5. AWS SNS (SMS Notifications)
# ------------------------------------------------------------------------------
# Create a standard SNS topic and copy its ARN here
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:ACCOUNT:pulsenet-notifications
